{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learn-anything.org/schema/module.schema.json",
  "title": "Learning Module",
  "description": "A thematic unit within a program, grouping related lessons",
  "type": "object",
  "required": ["id", "title", "description", "order", "lessons"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the module within the program (kebab-case)",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable module title",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Brief description of the module's focus and content",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "description": "Sequential order within the program (1-indexed)",
      "minimum": 1
    },
    "lessons": {
      "type": "array",
      "description": "Ordered list of lessons in this module",
      "items": {
        "type": "object",
        "required": ["id", "order"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Lesson identifier (matches lesson.yaml id)"
          },
          "order": {
            "type": "integer",
            "description": "Sequential order within the module (1-indexed)",
            "minimum": 1
          }
        }
      },
      "minItems": 1
    },
    "estimated_hours": {
      "type": "number",
      "description": "Estimated hours to complete this module",
      "minimum": 0
    },
    "objectives": {
      "type": "array",
      "description": "Module-level learning objectives",
      "items": {
        "type": "string"
      }
    }
  }
}
